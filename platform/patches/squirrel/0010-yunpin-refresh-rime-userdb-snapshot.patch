+  private func writeMaintenanceAcknowledgement(_ nonce: String, busy: Bool = false) -> Bool {
+    let directoryURL = FileManager.default.homeDirectoryForCurrentUser
+      .appendingPathComponent("Library", isDirectory: true)
+      .appendingPathComponent("Application Support", isDirectory: true)
+      .appendingPathComponent("YunPin", isDirectory: true)
+      .appendingPathComponent("Sync", isDirectory: true)
+    let directoryFD = open(directoryURL.path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW)
+    guard directoryFD >= 0 else {
+      return false
+    }
+    defer { close(directoryFD) }
+
+    var directoryMetadata = stat()
+    guard fstat(directoryFD, &directoryMetadata) == 0,
+          (directoryMetadata.st_mode & S_IFMT) == S_IFDIR,
+          directoryMetadata.st_uid == geteuid(),
+          (directoryMetadata.st_mode & 0o777) == 0o700 else {
+      return false
+    }
+
+    let acknowledgementName = "rime-maintenance.ack"
+    var existingMetadata = stat()
+    if fstatat(directoryFD, acknowledgementName, &existingMetadata, AT_SYMLINK_NOFOLLOW) == 0 {
+      guard (existingMetadata.st_mode & S_IFMT) == S_IFREG,
+            existingMetadata.st_uid == geteuid(),
+            (existingMetadata.st_mode & 0o777) == 0o600 else {
+        return false
+      }
+    } else if errno != ENOENT {
+      return false
+    }
+
+    let temporaryName = ".rime-maintenance.ack.\(nonce).tmp"
+    let temporaryFD = openat(directoryFD, temporaryName, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0o600)
+    guard temporaryFD >= 0 else {
+      return false
+    }
+    var renamed = false
+    defer {
+      close(temporaryFD)
+      if !renamed {
+        _ = unlinkat(directoryFD, temporaryName, 0)
+      }
+    }
+
+    var temporaryMetadata = stat()
+    guard fchmod(temporaryFD, 0o600) == 0,
+          fstat(temporaryFD, &temporaryMetadata) == 0,
+          (temporaryMetadata.st_mode & S_IFMT) == S_IFREG,
+          temporaryMetadata.st_uid == geteuid(),
+          (temporaryMetadata.st_mode & 0o777) == 0o600 else {
+      return false
+    }
+
+    let bytes = Array("\(busy ? "busy:" : "")\(nonce)\n".utf8)
+    let wroteAll = bytes.withUnsafeBytes { rawBuffer -> Bool in
+      guard let baseAddress = rawBuffer.baseAddress else {
+        return false
+      }
+      var offset = 0
+      while offset < rawBuffer.count {
+        let count = Darwin.write(temporaryFD, baseAddress.advanced(by: offset), rawBuffer.count - offset)
+        if count <= 0 {
+          return false
+        }
+        offset += count
+      }
+      return true
+    }
+    guard wroteAll, fsync(temporaryFD) == 0,
+          renameat(directoryFD, temporaryName, directoryFD, acknowledgementName) == 0 else {
+      return false
+    }
+    renamed = true
+    guard fsync(directoryFD) == 0 else {
+      _ = unlinkat(directoryFD, acknowledgementName, 0)
+      _ = fsync(directoryFD)
+      return false
+    }
+    return true
+  }
+
+  func syncUserData(requestNonce: String) {
+    guard SquirrelApp.validMaintenanceNonce(requestNonce) else {
+      print("Rejected invalid private Rime maintenance request.")
+      return
+    }
+    guard Thread.isMainThread else {
+      DispatchQueue.main.async { [weak self] in
+        self?.syncUserData(requestNonce: requestNonce)
+      }
+      return
+    }
+    guard SquirrelInputController.prepareForUserDataMaintenance() else {
+      print("Deferred private Rime maintenance while input is active or recently used.")
+      if !writeMaintenanceAcknowledgement(requestNonce, busy: true) {
+        print("Rime maintenance busy acknowledgement could not be committed.")
+      }
+      return
+    }
+    rimeSyncStateLock.lock()
+    guard !rimeSyncInFlight else {
+      rimeSyncStateLock.unlock()
+      print("Rejected overlapping private Rime maintenance request.")
+      if !writeMaintenanceAcknowledgement(requestNonce, busy: true) {
+        print("Rime maintenance busy acknowledgement could not be committed.")
+      }
+      return
+    }
+    rimeSyncInFlight = true
+    rimeSyncStateLock.unlock()
+
+    print("Refreshing private local Rime user data snapshot.")
+    guard rimeAPI.sync_user_data() else {
+      rimeSyncStateLock.lock()
+      rimeSyncInFlight = false
+      rimeSyncStateLock.unlock()
+      print("Rime user data snapshot refresh could not start.")
+      return
+    }
+    rimeSyncCompletionQueue.async { [weak self] in
+      guard let self else { return }
+      defer {
+        self.rimeSyncStateLock.lock()
+        self.rimeSyncInFlight = false
+        self.rimeSyncStateLock.unlock()
+      }
+      self.rimeAPI.join_maintenance_thread()
+      if !self.writeMaintenanceAcknowledgement(requestNonce) {
+        print("Rime user data snapshot acknowledgement could not be committed.")
+      }
+    }
+  }
+
+  func waitForRimeSyncCompletion() {
+    rimeSyncCompletionQueue.sync {}
   }
 
   func openLogFolder() {
