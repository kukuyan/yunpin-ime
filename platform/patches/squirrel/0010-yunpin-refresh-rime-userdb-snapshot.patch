+  private static func recordInputActivity() {
+    maintenanceStateLock.lock()
+    if !Thread.isMainThread {
+      controllerCallbacksAreMainThreadOnly = false
+    }
+    lastInputActivityUptime = ProcessInfo.processInfo.systemUptime
+    maintenanceStateLock.unlock()
+  }
+
+  static func prepareForUserDataMaintenance() -> Bool {
+    guard Thread.isMainThread else { return false }
+    maintenanceStateLock.lock()
+    let idleFor = ProcessInfo.processInfo.systemUptime - lastInputActivityUptime
+    let controllers = liveControllers.allObjects
+    let registryIsSafe = controllerCallbacksAreMainThreadOnly
+    maintenanceStateLock.unlock()
+    guard registryIsSafe, idleFor >= maintenanceIdleInterval else { return false }
+
+    for controller in controllers {
+      guard !controller.sessionLifetime.operationInProgress,
+            controller.chordKeyCount == 0,
+            controller.chordTimer?.isValid != true,
+            controller.preedit.isEmpty else {
+        return false
+      }
+      let session = controller.session
+      if session == 0 {
+        continue
+      }
+      if !controller.rimeAPI.find_session(session) {
+        controller.sessionLifetime.requestDestroy()
+        continue
+      }
+      var context = RimeContext_stdbool.rimeStructInit()
+      guard controller.rimeAPI.get_context(session, &context) else {
+        return false
+      }
+      let composing = context.composition.preedit != nil
+      _ = controller.rimeAPI.free_context(&context)
+      if composing {
+          return false
+      }
+    }
+    for controller in controllers {
+      controller.clearChord()
+      controller.sessionLifetime.requestDestroy()
+      guard controller.session == 0 else { return false }
+    }
+    return true
+  }
+
+  static func invalidateAllSessionsForRimeShutdown() -> Bool {
+    guard Thread.isMainThread else { return false }
+    maintenanceStateLock.lock()
+    let controllers = liveControllers.allObjects
+    let registryIsSafe = controllerCallbacksAreMainThreadOnly
+    maintenanceStateLock.unlock()
+    guard registryIsSafe else { return false }
+
+    for controller in controllers {
+      controller.clearChord()
+      controller.sessionLifetime.requestDestroy()
+    }
+    return controllers.allSatisfy { $0.session == 0 }
+  }
+
