+      _ = rimeAPI.destroy_session(appliedSnapshotSession)
+    }
+    appliedSnapshotSession = 0
+  }
+
+  func shouldIgnoreSnapshotProbeNotification(_ session: RimeSessionId) -> Bool {
+    rimeSyncStateLock.lock()
+    defer { rimeSyncStateLock.unlock() }
+    return session != 0 && session == snapshotProbeSession
+  }
+
+  func applyPrivateSnapshot(requestNonce: String) {
+    guard Thread.isMainThread else {
+      DispatchQueue.main.async { [weak self] in self?.applyPrivateSnapshot(requestNonce: requestNonce) }
+      return
+    }
+    guard let request = snapshotReloadRequest(requestNonce) else { return }
+    func acknowledge(_ outcome: String) {
+      let receipt = (request + [snapshotHostSession, String(getpid()), outcome]).joined(separator: "\t") + "\n"
+      if !writeMaintenanceAcknowledgement(requestNonce, acknowledgementName: "snapshot-reload.ack", contents: receipt) {
+        print("Private snapshot application receipt could not be committed.")
+      }
+    }
+    rimeSyncStateLock.lock()
+    let syncInFlight = rimeSyncInFlight
+    rimeSyncStateLock.unlock()
+    guard !syncInFlight, !rimeAPI.is_maintenance_mode(),
+          SquirrelInputController.prepareForUserDataMaintenance(invalidate: false) else {
+      acknowledge("busy")
+      return
+    }
+
+    // Build the new real filter/index before touching any old controller.
+    // Unlike deploy()/initialize(), this property is set by YunPinFilter only
+    // after parsing these exact bytes and atomically replacing its index.
+    let probe = rimeAPI.create_session()
+    guard probe != 0 else { acknowledge("failed"); return }
+    rimeSyncStateLock.lock()
+    snapshotProbeSession = probe
+    rimeSyncStateLock.unlock()
+    var retained = false
+    defer {
+      rimeSyncStateLock.lock()
+      snapshotProbeSession = 0
+      rimeSyncStateLock.unlock()
+      if !retained { _ = rimeAPI.destroy_session(probe) }
+    }
+    guard rimeAPI.select_schema(probe, "rime_ice") else { acknowledge("failed"); return }
+    var digest = [CChar](repeating: 0, count: 65)
+    guard rimeAPI.get_property(probe, "yunpin_snapshot_applied_digest", &digest, digest.count),
+          String(cString: digest) == request[3] else { acknowledge("failed"); return }
+    // Request removal/supersession means the caller already timed out. Never
+    // let an expired request invalidate otherwise working controller sessions.
+    guard snapshotReloadRequest(requestNonce) == request else { return }
+    // Recheck every controller after construction. No async/yield separates
+    // this final idle gate from invalidation on the serialized main thread.
+    guard SquirrelInputController.prepareForUserDataMaintenance() else {
+      acknowledge("busy")
+      return
+    }
+    clearAppliedSnapshotSession()
+    appliedSnapshotSession = probe
+    retained = true
+    acknowledge("applied")
+  }
