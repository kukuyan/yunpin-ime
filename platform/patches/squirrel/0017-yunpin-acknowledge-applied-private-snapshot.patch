+  private func snapshotReloadRequest(_ nonce: String) -> [String]? {
+    guard SquirrelApp.validMaintenanceNonce(nonce) else { return nil }
+    let directory = FileManager.default.homeDirectoryForCurrentUser
+      .appendingPathComponent("Library/Application Support/YunPin/Sync", isDirectory: true)
+    let directoryFD = open(directory.path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW)
+    guard directoryFD >= 0 else { return nil }
+    defer { close(directoryFD) }
+    var metadata = stat()
+    guard fstat(directoryFD, &metadata) == 0,
+          (metadata.st_mode & S_IFMT) == S_IFDIR, metadata.st_uid == geteuid(),
+          (metadata.st_mode & 0o777) == 0o700 else { return nil }
+    let requestFD = openat(directoryFD, "snapshot-reload.request", O_RDONLY | O_NOFOLLOW | O_NONBLOCK)
+    guard requestFD >= 0 else { return nil }
+    defer { close(requestFD) }
+    guard fstat(requestFD, &metadata) == 0,
+          (metadata.st_mode & S_IFMT) == S_IFREG, metadata.st_uid == geteuid(),
+          (metadata.st_mode & 0o777) == 0o600, metadata.st_size > 0, metadata.st_size <= 256 else { return nil }
+    var bytes = [UInt8](repeating: 0, count: 257)
+    let count = bytes.withUnsafeMutableBytes { buffer in
+      Darwin.read(requestFD, buffer.baseAddress, buffer.count)
+    }
+    guard count == metadata.st_size,
+          let text = String(bytes: bytes.prefix(count), encoding: .utf8), text.hasSuffix("\n") else { return nil }
+    let fields = String(text.dropLast()).components(separatedBy: "\t")
+    guard fields.count == 4, fields[0] == "v1", fields[1] == nonce,
+          let generation = UInt64(fields[2]), String(generation) == fields[2],
+          fields[3].utf8.count == 64,
+          SquirrelApp.validMaintenanceNonce(String(fields[3].prefix(32))),
+          SquirrelApp.validMaintenanceNonce(String(fields[3].suffix(32))) else { return nil }
+    return fields
+  }
+
+  private func clearAppliedSnapshotSession() {
