Subject: Open the bounded YunPin local settings page

Replace the upstream data-folder shortcut behind Settings with the packaged
YunPin settings command. The child inherits no terminal streams and the
executable must remain a regular, non-symlink member of the application bundle.

diff --git a/sources/SquirrelApplicationDelegate.swift b/sources/SquirrelApplicationDelegate.swift
index 6ea7c82..8e3b5a5 100644
--- a/sources/SquirrelApplicationDelegate.swift
+++ b/sources/SquirrelApplicationDelegate.swift
@@ -195,6 +195,30 @@ final class SquirrelApplicationDelegate: NSObject, NSApplicationDelegate {
     NSWorkspace.shared.open(SquirrelApp.userDir)
   }
 
+  func openYunPinSettings() {
+    guard let executableDirectory = Bundle.main.executableURL?.deletingLastPathComponent() else {
+      print("YunPin settings executable directory is unavailable.")
+      return
+    }
+    let settingsAgent = executableDirectory.appendingPathComponent("yunpin-sync-agent", isDirectory: false)
+    guard let values = try? settingsAgent.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey]),
+          values.isRegularFile == true, values.isSymbolicLink != true else {
+      print("YunPin settings agent is unavailable.")
+      return
+    }
+    let process = Process()
+    process.executableURL = settingsAgent
+    process.arguments = ["settings"]
+    process.standardInput = FileHandle.nullDevice
+    process.standardOutput = FileHandle.nullDevice
+    process.standardError = FileHandle.nullDevice
+    do {
+      try process.run()
+    } catch {
+      print("YunPin settings could not be opened.")
+    }
+  }
+
   func openWiki() {
     NSWorkspace.shared.open(Self.rimeWikiURL)
   }
