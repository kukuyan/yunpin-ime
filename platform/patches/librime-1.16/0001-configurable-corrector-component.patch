+      exact_path_reachable[syllable_end] = true;
+  }
+  exact_suffix_reachable.assign(input.length() + 1, false);
+  exact_suffix_reachable[input.length()] = true;
+  for (size_t path_pos = input.length(); path_pos-- > 0;) {
+    for (const size_t syllable_end : normal_exact_ends[path_pos]) {
+      if (exact_suffix_reachable[syllable_end]) {
+        exact_suffix_reachable[path_pos] = true;
+        break;
+      }
+    }
+  }
