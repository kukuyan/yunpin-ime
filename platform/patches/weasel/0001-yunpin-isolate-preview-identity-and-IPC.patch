 #define SDDL_ALL_APP_PACKAGES TEXT("AC")
@@ -20,56 +22,59 @@
   SDDL_ML_LOW                   \
   SDDL_ACE_END
 
-#define LOCAL_SYSTEM_FILE_ACCESS \
-  SDDL_ACE_BEGIN                 \
-  SDDL_ACCESS_ALLOWED            \
-  SDDL_SEPERATOR                 \
-  SDDL_SEPERATOR                 \
-  SDDL_FILE_ALL                  \
-  SDDL_SEPERATOR                 \
-  SDDL_SEPERATOR                 \
-  SDDL_SEPERATOR                 \
-  SDDL_LOCAL_SYSTEM              \
-  SDDL_ACE_END
+namespace weasel {
 
-#define EVERYONE_FILE_ACCESS \
-  SDDL_ACE_BEGIN             \
-  SDDL_ACCESS_ALLOWED        \
-  SDDL_SEPERATOR             \
-  SDDL_SEPERATOR             \
-  SDDL_FILE_ALL              \
-  SDDL_SEPERATOR             \
-  SDDL_SEPERATOR             \
-  SDDL_SEPERATOR             \
-  SDDL_EVERYONE              \
-  SDDL_ACE_END
+void SecurityAttribute::_Init() {
+  sa.nLength = sizeof(SECURITY_ATTRIBUTES);
+  sa.lpSecurityDescriptor = NULL;
+  sa.bInheritHandle = FALSE;
 
-#define ALL_APP_PACKAGES_FILE_ACCESS \
-  SDDL_ACE_BEGIN                     \
-  SDDL_ACCESS_ALLOWED                \
-  SDDL_SEPERATOR                     \
-  SDDL_SEPERATOR                     \
-  SDDL_FILE_ALL                      \
-  SDDL_SEPERATOR                     \
-  SDDL_SEPERATOR                     \
-  SDDL_SEPERATOR                     \
-  SDDL_ALL_APP_PACKAGES              \
-  SDDL_ACE_END
+  HANDLE token = NULL;
+  if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) {
+    return;
+  }
 
-namespace weasel {
+  DWORD token_size = 0;
+  GetTokenInformation(token, TokenUser, NULL, 0, &token_size);
+  if (GetLastError() != ERROR_INSUFFICIENT_BUFFER || token_size == 0) {
+    CloseHandle(token);
+    return;
+  }
 
-void SecurityAttribute::_Init() {
-  // Privileges for UWP and IE protected mode
-  // https://stackoverflow.com/questions/39138674/accessing-named-pipe-servers-from-within-ie-epm-bho
+  std::vector<BYTE> token_buffer(token_size);
+  if (!GetTokenInformation(token, TokenUser, token_buffer.data(), token_size,
+                           &token_size)) {
+    CloseHandle(token);
+    return;
+  }
+  CloseHandle(token);
 
-  ConvertStringSecurityDescriptorToSecurityDescriptor(
-      LOW_INTEGRITY_SDDL_SACL SDDL_DACL SDDL_DELIMINATOR
-          LOCAL_SYSTEM_FILE_ACCESS EVERYONE_FILE_ACCESS
-              ALL_APP_PACKAGES_FILE_ACCESS,
-      SDDL_REVISION_1, &pd, NULL);
-  sa.nLength = sizeof(SECURITY_ATTRIBUTES);
-  sa.lpSecurityDescriptor = pd;
-  sa.bInheritHandle = TRUE;
+  const TOKEN_USER* token_user =
+      reinterpret_cast<const TOKEN_USER*>(token_buffer.data());
+  LPWSTR user_sid = NULL;
+  if (!ConvertSidToStringSidW(token_user->User.Sid, &user_sid)) {
+    return;
+  }
+
+  // SYSTEM and the current user get full access. App-container clients get
+  // only the read/write rights needed by TSF hosts. The low-integrity label
+  // preserves protected-mode access without granting EVERYONE access.
+  std::wstring descriptor =
+      LOW_INTEGRITY_SDDL_SACL L"D:(A;;GA;;;SY)(A;;GA;;;";
+  descriptor += user_sid;
+  descriptor += L")(A;;GRGW;;;" SDDL_ALL_APP_PACKAGES L")";
+  LocalFree(user_sid);
+
+  if (ConvertStringSecurityDescriptorToSecurityDescriptorW(
+          descriptor.c_str(), SDDL_REVISION_1, &pd, NULL)) {
+    sa.lpSecurityDescriptor = pd;
+  }
+}
+
+SecurityAttribute::~SecurityAttribute() {
+  if (pd) {
+    LocalFree(pd);
+  }
 }
 
