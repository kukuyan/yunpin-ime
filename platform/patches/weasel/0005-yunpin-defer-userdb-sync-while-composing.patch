@@ -116,6 +125,8 @@ class Client {
   void EndSession();
   // 進入維護模式
   void StartMaintenance();
+  // 僅在所有輸入會話皆無未提交組字時進入維護模式
+  bool TryStartMaintenance();
   // 退出維護模式
   void EndMaintenance();
   // 测试连接
