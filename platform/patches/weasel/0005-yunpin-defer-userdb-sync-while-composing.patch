diff --git a/WeaselIPCServer/WeaselServerImpl.cpp b/WeaselIPCServer/WeaselServerImpl.cpp
index 21c05b8..3adf05c 100644
--- a/WeaselIPCServer/WeaselServerImpl.cpp
+++ b/WeaselIPCServer/WeaselServerImpl.cpp
@@ -295,9 +295,12 @@ DWORD ServerImpl::OnUpdateInputPosition(WEASEL_IPC_COMMAND uMsg,
 DWORD ServerImpl::OnStartMaintenance(WEASEL_IPC_COMMAND uMsg,
                                      DWORD wParam,
                                      DWORD lParam) {
-  if (m_pRequestHandler)
-    m_pRequestHandler->StartMaintenance();
-  return 0;
+  if (!m_pRequestHandler)
+    return FALSE;
+  if (wParam == WEASEL_IPC_MAINTENANCE_IF_IDLE)
+    return m_pRequestHandler->TryStartMaintenance() ? TRUE : FALSE;
+  m_pRequestHandler->StartMaintenance();
+  return TRUE;
 }
 
 DWORD ServerImpl::OnEndMaintenance(WEASEL_IPC_COMMAND uMsg,
