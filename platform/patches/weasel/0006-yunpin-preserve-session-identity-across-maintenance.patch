From: YunPin Maintainers <yunpin@example.invalid>
Date: Thu, 13 Aug 2026 00:00:00 +0000
Subject: [PATCH] Preserve session identity across maintenance

Maintenance used to clear the IPC-to-Rime session map before finalizing the
engine.  The next client then reused the first IPC session id while older TSF
clients still held that id.  A stale client could consequently address or
destroy a new client's Rime session after maintenance.

Keep IPC session ids monotonic for the lifetime of the server process and fail
closed on exhaustion.  Before global finalization, invalidate every map entry
and explicitly destroy its Rime session so the engine teardown cannot leave
client-owned session identities behind.  Make Finalize idempotent and let it
own the map clear ordering.
---
 RimeWithWeasel/RimeWithWeasel.cpp | 35 ++++++++++++++++++++++++++-------
 include/RimeWithWeasel.h          |  1 +
 2 files changed, 29 insertions(+), 7 deletions(-)

diff --git a/RimeWithWeasel/RimeWithWeasel.cpp b/RimeWithWeasel/RimeWithWeasel.cpp
index 12de578..73fd8c1 100644
--- a/RimeWithWeasel/RimeWithWeasel.cpp
+++ b/RimeWithWeasel/RimeWithWeasel.cpp
@@ -41,10 +41,14 @@ static void CleanOldLogs() {
   }
 }
 
-WeaselSessionId _GenerateNewWeaselSessionId(SessionStatusMap sm, DWORD pid) {
-  if (sm.empty())
-    return (WeaselSessionId)(pid + 1);
-  return (WeaselSessionId)(sm.rbegin()->first + 1);
+WeaselSessionId _GenerateNewWeaselSessionId(const SessionStatusMap& sm,
+                                            WeaselSessionId& next_id) {
+  while (next_id) {
+    const WeaselSessionId candidate = next_id++;
+    if (sm.find(candidate) == sm.end())
+      return candidate;
+  }
+  return 0;
 }
 
 int expand_ibus_modifier(int m) {
@@ -104,6 +108,7 @@ RimeWithWeaselHandler::RimeWithWeaselHandler(UI* ui)
     }
   }
   m_pid = (m_pid << (31 - msbit));
+  m_next_session_id = m_pid + 1;
   _Setup();
 }
 
@@ -201,8 +206,16 @@ void RimeWithWeaselHandler::Initialize() {
 }
 
 void RimeWithWeaselHandler::Finalize() {
+  if (m_disabled)
+    return;
   m_active_session = 0;
   m_disabled = true;
+  for (auto& pair : m_session_status_map) {
+    const RimeSessionId session_id = pair.second.session_id;
+    pair.second.session_id = 0;
+    if (session_id && rime_api->find_session(session_id))
+      rime_api->destroy_session(session_id);
+  }
   m_session_status_map.clear();
   LOG(INFO) << "Finalizing la rime.";
   YunPinStopNativeSelectionSpoolerV1();
@@ -237,7 +250,13 @@ DWORD RimeWithWeaselHandler::AddSession(LPWSTR buffer, EatLine eat) {
   }
 
   WeaselSessionId ipc_id =
-      _GenerateNewWeaselSessionId(m_session_status_map, m_pid);
+      _GenerateNewWeaselSessionId(m_session_status_map, m_next_session_id);
+  if (!ipc_id) {
+    if (session_id && rime_api->find_session(session_id))
+      rime_api->destroy_session(session_id);
+    LOG(ERROR) << "Refusing to reuse an exhausted Weasel session id.";
+    return 0;
+  }
   DLOG(INFO) << "Add session: created session_id = " << session_id
              << ", ipc_id = " << ipc_id;
   SessionStatus& session_status = new_session_status(ipc_id);
@@ -534,7 +553,6 @@ void RimeWithWeaselHandler::_GetCandidateInfo(CandidateInfo& cinfo,
 }
 
 void RimeWithWeaselHandler::StartMaintenance() {
-  m_session_status_map.clear();
   Finalize();
   _UpdateUI(0);
 }
diff --git a/include/RimeWithWeasel.h b/include/RimeWithWeasel.h
index b502220..74faacf 100644
--- a/include/RimeWithWeasel.h
+++ b/include/RimeWithWeasel.h
@@ -121,4 +121,5 @@ class RimeWithWeaselHandler : public weasel::RequestHandler {
   bool m_global_ascii_mode;
   int m_show_notifications_time;
   DWORD m_pid;
+  WeaselSessionId m_next_session_id = 0;
 };
