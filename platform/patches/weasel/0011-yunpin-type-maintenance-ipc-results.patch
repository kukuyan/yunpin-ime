+MaintenanceResult ClientImpl::TryStartMaintenanceResult() {
+  try {
+    // Do not use _SendMessage: its exception-to-zero conversion loses the
+    // distinction between a broken pipe and a successfully received reply.
+    PipeMessage request{WEASEL_IPC_START_MAINTENANCE,
+                        WEASEL_IPC_MAINTENANCE_IF_IDLE_V2, 0};
+    const auto result = DecodeMaintenanceReply(channel.Transact(request));
+    if (result == MaintenanceResult::Accepted)
+      session_id = 0;
+    return result;
+  } catch (DWORD) {
+    return MaintenanceResult::Unavailable;
+  }
+}
