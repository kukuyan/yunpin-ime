diff --git a/include/YunPinMaintenanceResult.h b/include/YunPinMaintenanceResult.h
new file mode 100644
index 0000000..30781b4
--- /dev/null
+++ b/include/YunPinMaintenanceResult.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+namespace weasel {
+// Nonzero, versioned wire values: a legacy boolean reply is never a v2 ACK.
+enum class MaintenanceResult : unsigned long {
+  Accepted = 0x59500101,
+  ComposingBusy = 0x59500102,
+  Unavailable = 0x59500103,
+  ProtocolError = 0x59500104,
+};
+
+inline MaintenanceResult DecodeMaintenanceReply(unsigned long value) {
+  switch (value) {
+    case static_cast<unsigned long>(MaintenanceResult::Accepted):
+    case static_cast<unsigned long>(MaintenanceResult::ComposingBusy):
+    case static_cast<unsigned long>(MaintenanceResult::Unavailable):
+    case static_cast<unsigned long>(MaintenanceResult::ProtocolError):
+      return static_cast<MaintenanceResult>(value);
+    default:
+      return MaintenanceResult::ProtocolError;
+  }
+}
+}  // namespace weasel

