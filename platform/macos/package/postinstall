#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
set -euo pipefail

readonly yunpin_legacy_correction_overlay_sha256="19dbc7deda115dbd7e3ea5b28ba9abfe406105d14f3f818d53c0998cf154ca45"
readonly yunpin_conservative_overlay_sha256="2bb3bf0666495843201a70e226710de18820f4222daf7df15ed94e9e0adcad37"

yunpin_sha256() {
  /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'
}

yunpin_migrate_known_correction_overlay() {
  local packaged_overlay="$1"
  local user_overlay="$2"
  local owner="$3"
  local current_hash
  local packaged_hash
  local replacement_tmp
  local replacement_hash
  local timestamp
  local backup
  local backup_hash

  # A missing file is handled by the normal fresh-install loop below. Never
  # follow a user-controlled link or replace an unrecognised file type.
  if [[ -L "$user_overlay" ]]; then
    echo "YunPin: preserving linked user overlay: $user_overlay" >&2
    return 0
  fi
  if [[ ! -e "$user_overlay" ]]; then
    return 0
  fi
  if [[ ! -f "$user_overlay" ]]; then
    echo "YunPin: preserving non-regular user overlay: $user_overlay" >&2
    return 0
  fi

  if ! current_hash="$(yunpin_sha256 "$user_overlay")"; then
    echo "YunPin: could not hash user overlay; preserving it" >&2
    return 1
  fi
  if [[ "$current_hash" != "$yunpin_legacy_correction_overlay_sha256" ]]; then
    return 0
  fi

  # Fail closed if a future package changes the replacement without also
  # reviewing this versioned migration.
  if [[ -L "$packaged_overlay" || ! -f "$packaged_overlay" ]]; then
    echo "YunPin: conservative packaged overlay is unavailable" >&2
    return 1
  fi
  if ! packaged_hash="$(yunpin_sha256 "$packaged_overlay")"; then
    echo "YunPin: could not hash conservative packaged overlay" >&2
    return 1
  fi
  if [[ "$packaged_hash" != "$yunpin_conservative_overlay_sha256" ]]; then
    echo "YunPin: conservative packaged overlay hash mismatch" >&2
    return 1
  fi

  # Stage the replacement in the same directory so the final rename is
  # atomic. All failure paths before that rename leave the active file intact.
  if ! replacement_tmp="$(/usr/bin/mktemp "${user_overlay}.migration.XXXXXX")"; then
    echo "YunPin: could not stage conservative overlay" >&2
    return 1
  fi
  if ! /usr/bin/install -m 600 -o "$owner" "$packaged_overlay" "$replacement_tmp"; then
    /bin/rm -f "$replacement_tmp"
    return 1
  fi
  if ! replacement_hash="$(yunpin_sha256 "$replacement_tmp")" || \
    [[ "$replacement_hash" != "$yunpin_conservative_overlay_sha256" ]]; then
    echo "YunPin: staged conservative overlay failed verification" >&2
    /bin/rm -f "$replacement_tmp"
    return 1
  fi

  timestamp="$(/bin/date -u +%Y%m%dT%H%M%SZ)"
  if ! backup="$(/usr/bin/mktemp "${user_overlay}.pre-conservative-${timestamp}.XXXXXX")"; then
    echo "YunPin: could not create legacy overlay backup" >&2
    /bin/rm -f "$replacement_tmp"
    return 1
  fi
  if ! /usr/bin/install -m 600 -o "$owner" "$user_overlay" "$backup"; then
    /bin/rm -f "$replacement_tmp" "$backup"
    return 1
  fi
  if ! backup_hash="$(yunpin_sha256 "$backup")" || \
    [[ "$backup_hash" != "$yunpin_legacy_correction_overlay_sha256" ]]; then
    echo "YunPin: legacy overlay changed during backup; preserving it" >&2
    /bin/rm -f "$replacement_tmp" "$backup"
    return 1
  fi

  # Re-check immediately before replacement so a concurrent user edit wins.
  if ! current_hash="$(yunpin_sha256 "$user_overlay")" || \
    [[ "$current_hash" != "$yunpin_legacy_correction_overlay_sha256" ]]; then
    echo "YunPin: user overlay changed during migration; preserving it" >&2
    /bin/rm -f "$replacement_tmp" "$backup"
    return 1
  fi
  if ! /bin/mv -f "$replacement_tmp" "$user_overlay"; then
    /bin/rm -f "$replacement_tmp"
    return 1
  fi

  echo "YunPin: migrated known legacy correction overlay; backup: $backup" >&2
}

# Tests source this file to exercise the migration in an isolated directory.
# Installer execution is unaffected because BASH_SOURCE[0] and $0 are equal.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

app="/Library/Input Methods/YunPin.app"
executable="$app/Contents/MacOS/YunPin"
shared="$app/Contents/SharedSupport"
login_user="$(/usr/bin/stat -f%Su /dev/console)"

if [[ "$login_user" == "root" || ! -x "$executable" ]]; then
  exit 0
fi

user_home="$(/usr/bin/dscl . -read "/Users/$login_user" NFSHomeDirectory | /usr/bin/awk '{print $2}')"
user_rime="$user_home/Library/Application Support/YunPin/Rime"
/usr/bin/install -d -m 700 -o "$login_user" "$user_rime"
/usr/bin/install -d -m 700 -o "$login_user" "$user_rime/lua"
/usr/bin/install -m 600 -o "$login_user" "$shared/lua/lunar.db" "$user_rime/lua/lunar.db"

yunpin_migrate_known_correction_overlay \
  "$shared/rime_ice.custom.yaml" \
  "$user_rime/rime_ice.custom.yaml" \
  "$login_user"

for overlay in default.custom.yaml squirrel.custom.yaml rime_ice.custom.yaml; do
  if [[ ! -e "$user_rime/$overlay" && ! -L "$user_rime/$overlay" ]]; then
    /usr/bin/install -m 600 -o "$login_user" "$shared/$overlay" "$user_rime/$overlay"
  fi
done

/usr/bin/killall YunPin >/dev/null 2>&1 || true
"$executable" --register-input-source
/usr/bin/sudo -u "$login_user" "$executable" --enable-input-source
exit 0
